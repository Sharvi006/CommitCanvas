# Resend API key used only by server.js. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: use a verified sender address after configuring your domain in Resend.
# RESEND_FROM_EMAIL=CommitCanvas <no-reply@your-domain.com>

# Optional backend settings
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Frontend API base URL (safe to expose; it is not a secret)
VITE_API_BASE_URL=http://localhost:5000
